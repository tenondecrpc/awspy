# Active edition shown at the bare URL (/, /speakers, /schedule, ...).
# Past editions live under /editions/{year}/... regardless of this value.
# Required.
CURRENT_EDITION=2026

# Public origin used for canonical URLs, sitemap, OG image, and JSON-LD.
# Required for production deployments; safe to leave at localhost in dev.
# Production: https://awscommunitydayparaguay.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional override for the Sessionize API base URL. Defaults to
# https://sessionize.com/api/v2 when unset. Useful for offline tests against
# a local fixture server (see tests/fixtures/sessionize/).
# NEXT_PUBLIC_SESSIONIZE_BASE_URL=https://sessionize.com/api/v2

# Development only. When set to 1, the content loaders prefer a
# `<name>.example.json` sibling over the live file for the sections that ship
# empty (sponsors, organizers, venue), so their design can be reviewed with
# placeholder records. Each substitution is announced in the terminal.
# Production builds ignore this flag; see `editionFile` in lib/content/_fs.ts.
#
# Put it in `.env.local` (gitignored) to have your usual `npm run dev` pick it
# up. For the schedule and the speakers as well, use `npm run dev:preview`,
# which also starts the local Sessionize fixture server.
# See content/preview/README.md.
# CONTENT_PREVIEW=1
